#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly ROOT
# shellcheck source=../sources.env
source "$ROOT/sources.env"
OMARCHY_TEST_SOURCE=${OMARCHY_TEST_SOURCE:-"$ROOT/../omarchy-aarch64"}
OMARCHY_TEST_SOURCE=$(realpath -e -- "$OMARCHY_TEST_SOURCE")
readonly OMARCHY_TEST_SOURCE
OMARCHY_TEST_PACKAGES=${OMARCHY_TEST_PACKAGES:-"$ROOT/../omarchy-pkgs-aarch64"}
OMARCHY_TEST_PACKAGES=$(realpath -e -- "$OMARCHY_TEST_PACKAGES")
readonly OMARCHY_TEST_PACKAGES

git -C "$OMARCHY_TEST_SOURCE" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "FAIL: set OMARCHY_TEST_SOURCE to an omarchy-aarch64 checkout" >&2
  exit 1
}
git -C "$OMARCHY_TEST_PACKAGES" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "FAIL: set OMARCHY_TEST_PACKAGES to an omarchy-pkgs-aarch64 checkout" >&2
  exit 1
}

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

pass() {
  echo "PASS: $*"
}

while IFS= read -r script; do
  bash -n "$script" || fail "bash syntax: ${script#$ROOT/}"
done < <(find "$ROOT/bin" -type f -print; find "$ROOT/profiles" -type f -perm /111 -print)
bash -n "$OMARCHY_TEST_SOURCE/install/user/mise-work.sh"
bash -n "$OMARCHY_TEST_SOURCE/install/hardware/all.sh"
bash -n "$OMARCHY_TEST_SOURCE/install/hardware/virtual-machine.sh"
bash -n "$OMARCHY_TEST_SOURCE/install/post-install/pacman.sh"
bash -n "$OMARCHY_TEST_SOURCE/bin/omarchy-provision-owner"
pass "all project and modified runtime scripts parse as Bash"

python3 - "$ROOT/utm/Omarchy-virt.utm/config.plist" "$ROOT/utm/icon.png.base64" <<'PY'
import base64
import pathlib
import plistlib
import sys

config_path = pathlib.Path(sys.argv[1])
with config_path.open("rb") as stream:
    config = plistlib.load(stream)

assert config["Backend"] == "QEMU"
assert config["System"]["Architecture"] == "aarch64"
assert config["System"]["Target"] == "virt"
assert config["QEMU"]["UEFIBoot"] is True
assert config["Drive"][0]["ImageName"] == "omarchy-aarch64-virt.qcow2"
assert config["Drive"][0]["Interface"] == "VirtIO"
assert config["Sharing"]["DirectoryShareMode"] == "VirtFS"
assert config["Display"][0]["DynamicResolution"] is True
assert config["Display"][0]["NativeResolution"] is True

encoded_icon = b"".join(pathlib.Path(sys.argv[2]).read_bytes().split())
icon = base64.b64decode(encoded_icon, validate=True)
assert icon.startswith(b"\x89PNG\r\n\x1a\n")
PY
if find "$ROOT/utm" -type f \( -name 'efi_vars.fd' -o -name '*.qcow2' -o -name '*.vmstate' \) |
  grep -q .; then
  fail "the versioned UTM template contains machine-specific runtime state"
fi
pass "UTM template is a clean AArch64 virt configuration without EFI state"

(
  fixture=$(mktemp -d)
  trap 'rm -rf "$fixture"' EXIT
  truncate --size 2500K "$fixture/test.qcow2"
  printf 'test_provenance=yes\n' >"$fixture/image-provenance.txt"
  for suffix in all-packages.txt explicit-packages.txt packages.tsv orphans.txt; do
    printf 'test metadata\n' >"$fixture/test.$suffix"
  done
  : >"$fixture/test.orphans.txt"

  OMARCHY_UTM_PART_SIZE_MIB=1 "$ROOT/bin/package-utm-release" \
    --tag v4.0.2-test.1 \
    --image "$fixture/test.qcow2" \
    --provenance "$fixture/image-provenance.txt" \
    --output "$fixture/release" >/dev/null

  (cd "$fixture/release" && sha256sum --check SHA256SUMS >/dev/null) ||
    fail "UTM release asset checksums are invalid"
  bash -n "$fixture/release/install-Omarchy-virt.command"
  [[ -x $fixture/release/install-Omarchy-virt.command ]] ||
    fail "macOS UTM installer is not executable"
  mapfile -t parts < <(find "$fixture/release" -maxdepth 1 -type f \
    -name 'Omarchy-virt.utm.zip.part-*' -print | sort)
  ((${#parts[@]} >= 2)) || fail "the release packager did not split its archive"
  cat -- "${parts[@]}" >"$fixture/Omarchy-virt.utm.zip"
  (cd "$fixture" && sha256sum --check release/Omarchy-virt.utm.zip.sha256 >/dev/null) ||
    fail "the reconstructed UTM archive checksum is invalid"

  python3 - "$fixture/Omarchy-virt.utm.zip" "$fixture/release/release-manifest.json" \
    "$fixture/release/Install-Omarchy-virt.zip" \
    "$fixture/release/image-package-inventory.zip" <<'PY'
import json
import plistlib
import stat
import sys
import zipfile

archive_path, manifest_path, installer_path, inventory_path = sys.argv[1:]
with zipfile.ZipFile(archive_path) as archive:
    names = set(archive.namelist())
    assert "Omarchy-virt.utm/config.plist" in names
    assert "Omarchy-virt.utm/Data/icon.png" in names
    assert "Omarchy-virt.utm/Data/omarchy-aarch64-virt.qcow2" in names
    assert not any(name.endswith("efi_vars.fd") for name in names)
    config = plistlib.loads(archive.read("Omarchy-virt.utm/config.plist"))
    assert config["System"]["Target"] == "virt"

with open(manifest_path, encoding="utf-8") as stream:
    manifest = json.load(stream)
assert manifest["schema"] == 1
assert manifest["release_tag"] == "v4.0.2-test.1"
assert manifest["template"]["efi_variable_storage"] == "omitted-and-created-by-utm"
assert len(manifest["utm_archive"]["parts"]) >= 2

with zipfile.ZipFile(installer_path) as archive:
    info = archive.getinfo("install-Omarchy-virt.command")
    mode = info.external_attr >> 16
    assert mode & stat.S_IXUSR

with zipfile.ZipFile(inventory_path) as archive:
    assert set(archive.namelist()) == {
        "all-packages.txt",
        "explicit-packages.txt",
        "packages.tsv",
        "orphans.txt",
    }
PY
  if find "$fixture/release" -maxdepth 1 -type f -empty -print -quit | grep -q .; then
    fail "the release contains a zero-byte asset rejected by GitHub"
  fi
  pass "UTM release packager produces verified split assets and installer"
)

if command -v shellcheck >/dev/null 2>&1; then
  shellcheck "$ROOT"/bin/* "$ROOT"/profiles/aarch64-virt/overlay/usr/lib/omarchy-aarch64/grow-root
  pass "project scripts pass shellcheck"
fi

(
  # shellcheck source=../bin/build-image
  source "$ROOT/bin/build-image"
  fixture=$(mktemp -d)
  trap 'rm -rf "$fixture"' EXIT

  printf '%s\n' keep from-repository excluded old >"$fixture/base"
  printf '%s\n' from-repository >"$fixture/repository"
  printf '%s\n' excluded >"$fixture/excluded"
  printf '%s\n' 'old replacement' >"$fixture/replacements"
  printf '%s\n' runtime keep >"$fixture/runtime"

  mapfile -t resolved < <(
    resolve_official_packages \
      "$fixture/base" "$fixture/repository" "$fixture/excluded" \
      "$fixture/replacements" "$fixture/runtime"
  )
  [[ ${resolved[*]} == "keep replacement runtime" ]] ||
    fail "package resolution produced: ${resolved[*]}"
  pass "package resolution separates repository/unsupported targets and applies replacements"

  select_profile --profile aarch64-virt
  [[ $PROFILE_DIR == "$ROOT/profiles/aarch64-virt" ]] || fail "profile directory was not selected"
  [[ $OUTPUT_PATH == "$ROOT/build/omarchy-aarch64-virt.qcow2" ]] ||
    fail "profile default output is incorrect: $OUTPUT_PATH"
  validate_remove_package_patterns

  MODULES=(virtio_blk thunderbolt virtio_gpu)
  HOOKS=(base udev microcode autodetect plymouth filesystems)
  # shellcheck source=/dev/null
  source "$PROFILE_DIR/overlay/etc/mkinitcpio.conf.d/zz-omarchy-aarch64-virt.conf"
  [[ ${MODULES[*]} == "virtio_blk virtio_gpu" ]] ||
    fail "aarch64-virt mkinitcpio module filter produced: ${MODULES[*]}"
  [[ ${HOOKS[*]} == "base udev autodetect plymouth filesystems" ]] ||
    fail "aarch64-virt mkinitcpio hook filter produced: ${HOOKS[*]}"

  MOUNT_DIR="$fixture/target"
  OMARCHY_SOURCE_DIR=$OMARCHY_TEST_SOURCE
  hook_dir="$MOUNT_DIR/etc/pacman.d/hooks"
  hook_name=90-mkinitcpio-install.hook
  mkdir -p "$hook_dir"
  printf 'original hook\n' >"$hook_dir/$hook_name"
  mask_target_boot_hooks "$hook_name"
  is_devnull_symlink "$hook_dir/$hook_name" || fail "boot hook was not masked"
  [[ -f $hook_dir/$hook_name.omarchy-image-backup ]] ||
    fail "boot hook was not preserved while masked"
  unmask_target_boot_hooks "$hook_name"
  [[ $(<"$hook_dir/$hook_name") == "original hook" ]] ||
    fail "boot hook was not restored byte-for-byte"
  assert_target_boot_hooks_restored

  printf '[core]\nInclude = /etc/pacman.d/mirrorlist\n' >"$MOUNT_DIR/etc/pacman.conf"
  write_omarchy_repository_configuration
  grep -qxF 'Include = /etc/pacman.d/omarchy-aarch64.conf' \
    "$MOUNT_DIR/etc/pacman.conf" || fail "signed repository include was not installed"
  grep -qxF 'SigLevel = Required' "$MOUNT_DIR/etc/pacman.d/omarchy-aarch64.conf" ||
    fail "signed repository does not require signatures"
  cmp -s "$OMARCHY_TEST_SOURCE/default/pacman/omarchy-aarch64-repositories.conf" \
    "$MOUNT_DIR/etc/omarchy-aarch64/repositories.conf" ||
    fail "image did not install the runtime-owned channel mapping"
  write_omarchy_repository_configuration file:///run/omarchy-aarch64-repository
  grep -qxF 'Server = file:///run/omarchy-aarch64-repository' \
    "$MOUNT_DIR/etc/pacman.d/omarchy-aarch64.conf" ||
    fail "local signed repository cannot be selected during development builds"
  write_omarchy_repository_configuration
  grep -qxF "Server = $OMARCHY_AARCH64_REPOSITORY_URL" \
    "$MOUNT_DIR/etc/pacman.d/omarchy-aarch64.conf" ||
    fail "development builds do not restore the public update repository"
  bash -n "$MOUNT_DIR/etc/skel/.config/omarchy/hooks/pre-refresh-pacman.d/omarchy-aarch64-repository"
  cmp -s "$OMARCHY_TEST_SOURCE/default/pacman/omarchy-aarch64-pre-refresh" \
    "$MOUNT_DIR/etc/skel/.config/omarchy/hooks/pre-refresh-pacman.d/omarchy-aarch64-repository" ||
    fail "image duplicated the runtime refresh hook instead of installing it"

  for package in gpu-screen-recorder obs-studio qemu-user-static-binfmt; do
    grep -qx "$package" "$PROFILE_DIR/excluded-packages" ||
      fail "aarch64-virt no longer excludes unsupported package: $package"
  done
  for package in asdcontrol bluez bluez-tools bluez-utils bolt brightnessctl \
    clang ddcutil docker docker-buildx docker-compose hyprland-preview-share-picker \
    hyprsunset kdenlive lazydocker libreoffice-fresh mariadb-libs moonlight-qt \
    postgresql-libs power-profiles-daemon python-poetry-core ruby tree-sitter-cli \
    wireless-regdb; do
    if grep -qx "$package" "$PROFILE_DIR/excluded-packages"; then
      fail "aarch64-virt still excludes a supported upstream default: $package"
    fi
  done
  for package in bindfs dotnet-runtime-bin obsidian pinta tensaku tzupdate ufw-docker tobi-try \
    omarchy-aarch64-config; do
    grep -qx "$package" "$ROOT/config/omarchy-packages.aarch64" ||
      fail "required Omarchy repository package is not selected: $package"
  done
  for package in dotnet-runtime obsidian pinta tensaku tzupdate; do
    if grep -qx "$package" "$PROFILE_DIR/excluded-packages"; then
      fail "supported AArch64 desktop package remains excluded: $package"
    fi
  done
  for package in gst-plugin-pipewire pipewire pipewire-alsa pipewire-audio pipewire-jack \
    pipewire-pulse wireplumber; do
    grep -qx "$package" "$PROFILE_DIR/runtime-packages" ||
      fail "aarch64-virt audio stack is missing: $package"
  done

  output_fixture="$fixture/output.qcow2"
  OUTPUT_PATH="$output_fixture"
  IMAGE_FORMAT=qcow2
  FORCE=1
  : >"$output_fixture"
  : >"$output_fixture.part"
  validate_outputs
  [[ -e $output_fixture ]] || fail "--force discarded the previous image before replacement"
  [[ ! -e $output_fixture.part ]] || fail "stale image conversion partial was not removed"

  printf 'replacement image\n' >"$output_fixture.part"
  finalize_image_artifact "$output_fixture.part" "$output_fixture"
  [[ $(<"$output_fixture") == "replacement image" ]] ||
    fail "atomic image finalization did not replace the destination"
  (cd "$fixture" && sha256sum -c output.qcow2.sha256 >/dev/null) ||
    fail "atomic image finalization published an invalid checksum"

  target_chroot() {
    printf '%s\n' base dhcpcd ex-vi-compat haveged linux-aarch64 linux-firmware \
      linux-firmware-amdgpu nano net-tools netctl sof-firmware
  }
  mapfile -t removed < <(resolve_profile_removed_packages)
  [[ ${removed[*]} == "dhcpcd ex-vi-compat haveged linux-firmware linux-firmware-amdgpu nano net-tools netctl sof-firmware" ]] ||
    fail "profile removal rules selected: ${removed[*]}"
  pass "aarch64-virt owns its VM desktop, audio stack, shell, and package-removal policy"
)

comm -12 \
  <(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$ROOT/config/omarchy-packages.aarch64" | sort) \
  <(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$ROOT/profiles/aarch64-virt/excluded-packages" | sort) |
  grep -q . && fail "a package is both repository-managed and excluded"
pass "AArch64 repository and exclusion manifests are disjoint"

cmp -s "$ROOT/profiles/aarch64-virt/excluded-packages" \
  "$OMARCHY_TEST_PACKAGES/pkgbuilds/omarchy-aarch64-config/excluded-packages" ||
  fail "image-build and upgrade-time package exclusions have drifted"
cmp -s "$ROOT/profiles/aarch64-virt/package-replacements" \
  "$OMARCHY_TEST_PACKAGES/pkgbuilds/omarchy-aarch64-config/package-replacements" ||
  fail "image-build and upgrade-time package replacements have drifted"
pass "image and package-managed runtime profiles share one package policy"

(
  # shellcheck source=../bin/build-image
  source "$ROOT/bin/build-image"
  fixture=$(mktemp -d)
  trap 'rm -rf "$fixture"' EXIT
  packages_json=$(
    read_list "$ROOT/config/omarchy-packages.aarch64" |
      jq -R --arg version "$OMARCHY_AARCH64_PACKAGE_VERSION" '
        {name: ., version: (if (. == "omarchy" or . == "omarchy-settings") then
          $version
        else "1-1" end)}
      ' | jq --slurp .
  )
  jq -n \
    --arg fingerprint "$OMARCHY_AARCH64_SIGNING_FINGERPRINT" \
    --arg commit "$OMARCHY_PKGS_AARCH64_REF" \
    --argjson packages "$packages_json" '
      {
        schema: 1,
        commit: $commit,
        generated_at: "2026-08-26T00:00:00Z",
        signing_fingerprint: $fingerprint,
        state: {
          schema: 1,
          architecture: "aarch64",
          channel: "stable",
          commit: $commit,
          package_base_count: 118,
          packages: $packages
        }
      }
    ' >"$fixture/repository-manifest.json"
  OMARCHY_SOURCE_COMMIT=$OMARCHY_AARCH64_REF
  validate_omarchy_repository_manifest "$fixture/repository-manifest.json"
  [[ $OMARCHY_REPOSITORY_OMARCHY_VERSION == "$OMARCHY_AARCH64_PACKAGE_VERSION" ]] ||
    fail "repository/source version boundary was not captured"

  rejects_manifest() {
    if bash -c '
      source "$1"
      validate_omarchy_repository_manifest "$2"
    ' _ "$ROOT/bin/build-image" "$1" >/dev/null 2>&1; then
      fail "repository manifest accepted $2"
    fi
  }

  jq '.commit = "0000000000000000000000000000000000000000"
    | .state.commit = .commit' \
    "$fixture/repository-manifest.json" >"$fixture/wrong-package-commit.json"
  rejects_manifest "$fixture/wrong-package-commit.json" "the wrong package commit"
  jq '(.state.packages[] | select(.name == "omarchy-settings").version) = "4.0.2-2"' \
    "$fixture/repository-manifest.json" >"$fixture/wrong-runtime-version.json"
  rejects_manifest "$fixture/wrong-runtime-version.json" "a divergent runtime package version"
  pass "signed stable repository manifest matches the pinned source, package version, and package commit"
)

[[ $(git -C "$OMARCHY_TEST_PACKAGES" rev-parse HEAD) == "$OMARCHY_PKGS_AARCH64_REF" ]] ||
  fail "package checkout does not match the immutable source pin"
for package in omarchy omarchy-settings; do
  read -r package_source package_version < <(
    bash -c '
      source "$1"
      printf "%s %s-%s\n" "$_commit" "$pkgver" "$pkgrel"
    ' _ "$OMARCHY_TEST_PACKAGES/pkgbuilds/$package/PKGBUILD"
  )
  [[ $package_source == "$OMARCHY_AARCH64_REF" ]] ||
    fail "$package recipe does not pin the selected Omarchy source"
  [[ $package_version == "$OMARCHY_AARCH64_PACKAGE_VERSION" ]] ||
    fail "$package recipe version does not match the image input contract"
done
pass "pinned package recipes bind the exact Omarchy source and runtime package version"

mapfile -t image_profiles < <(find "$ROOT/profiles" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
[[ ${image_profiles[*]} == aarch64-virt ]] ||
  fail "the current release must expose only the aarch64-virt image profile"
pass "the current release exposes only the aarch64-virt image profile"

grep -Fxq 'ENABLE_UKI=yes' "$OMARCHY_TEST_SOURCE/etc/limine-entry-tool.d/omarchy-uki.conf" ||
  fail "the AArch64 fork does not enable Omarchy's UKI boot path"
if grep -Eq '^(ENABLE_UKI|FIND_BOOTLOADERS)=' \
  "$OMARCHY_TEST_SOURCE/default/limine/default.conf"; then
  fail "the AArch64 fork overrides Omarchy's UKI or bootloader-discovery defaults"
fi
if grep -Eq '^[[:space:]]*(protocol: linux|path: boot\(\):/Image|module_path:)' \
  "$OMARCHY_TEST_SOURCE/default/limine/limine.conf"; then
  fail "the AArch64 fork still carries a static kernel/initramfs boot entry"
fi
for package in limine-mkinitcpio-hook omarchy-aarch64-config omarchy-spice-guest-tools; do
  grep -qx "$package" "$ROOT/config/omarchy-packages.aarch64" ||
    fail "signed repository package is not selected: $package"
done
grep -Fq 'usr/bin/spice-guest-tools' "$ROOT/bin/build-image" ||
  fail "the image does not validate the SPICE guest-tools payload"
pass "aarch64-virt consumes its adapted Limine and SPICE packages from the signed repository"

grep -Fq 'plymouth-set-default-theme omarchy' "$ROOT/bin/build-image" ||
  fail "image assembly does not explicitly select the Omarchy boot theme"
grep -Fq 'mount_target_uefi_view' "$ROOT/bin/build-image" ||
  fail "image assembly does not present its UEFI target to the offline chroot"
grep -Fq 'target_chroot limine-update' "$ROOT/bin/build-image" ||
  fail "image assembly does not build the AArch64 UKI through Limine's normal interface"
if grep -R -q 'LIMINE_FORCE_UEFI' "$ROOT/bin"; then
  fail "image assembly bypasses Limine's native UEFI detection"
fi
grep -Fq 'boot/EFI/Linux/omarchy_linux.efi' "$ROOT/bin/build-image" ||
  fail "image validation does not require the stable Omarchy UKI"
grep -Fq "grep -Eq '^==> ERROR:|^ERROR:'" "$ROOT/bin/build-image" ||
  fail "native AArch64 image assembly accepts UKI build errors"
grep -Fq '== thunderbolt' \
  "$ROOT/profiles/aarch64-virt/overlay/etc/mkinitcpio.conf.d/zz-omarchy-aarch64-virt.conf" ||
  fail "aarch64-virt still requests the physical Thunderbolt kernel module"
grep -Fq '== microcode' \
  "$ROOT/profiles/aarch64-virt/overlay/etc/mkinitcpio.conf.d/zz-omarchy-aarch64-virt.conf" ||
  fail "aarch64-virt still requests the x86 microcode mkinitcpio hook"
grep -Fq 'usr/share/plymouth/themes/omarchy/omarchy.plymouth' "$ROOT/bin/build-image" ||
  fail "image validation does not require the Omarchy Plymouth theme"
grep -Fq 'usr/bin/plymouthd' "$ROOT/bin/build-image" ||
  fail "image validation does not inspect the initramfs for Plymouth"
grep -Fq 'console=ttyAMA0,115200 plymouth.ignore-serial-consoles' "$ROOT/bin/build-image" ||
  fail "the QEMU serial console suppresses the graphical Plymouth splash"
grep -Fq 'multi-user.target.wants/limine-snapper-sync.service' "$ROOT/bin/build-image" ||
  fail "image validation does not require Limine snapshot synchronization"
grep -Fq 'stop_target_background_helpers || true' "$ROOT/bin/build-image" ||
  fail "failed image builds do not stop chroot helpers before unmounting"
grep -Fq 'assert_target_boot_hooks_restored' "$ROOT/bin/build-image" ||
  fail "image assembly does not verify that deferred boot hooks were restored"
grep -Fq 'btrfs quota disable /' "$ROOT/bin/build-image" ||
  fail "image assembly does not match the official post-Limine quota policy"
grep -Fq 'target_chroot pacman -Qqe' "$ROOT/bin/build-image" ||
  fail "successful images do not publish their exact explicit package inventory"
grep -Fq 'target_chroot expac -Q' "$ROOT/bin/build-image" ||
  fail "successful images do not publish an auditable package manifest"
pass "the complete Omarchy UKI, primary Limine, and Plymouth boot experience is enforced"

[[ ! -e $ROOT/profiles/aarch64-virt/overlay/etc/systemd/system/omarchy-aarch64-setup-direct-boot.service ]] ||
  fail "the VM profile still enables direct UKI boot automatically"
[[ ! -e $ROOT/profiles/aarch64-virt/overlay/usr/lib/omarchy-aarch64/setup-direct-boot ]] ||
  fail "the VM profile still ships its own automatic direct-boot helper"
! grep -Fq 'omarchy-aarch64-setup-direct-boot' "$ROOT/bin/build-image" ||
  fail "image assembly still registers direct UKI boot automatically"
grep -Fq 'gum confirm "Setup direct boot' "$OMARCHY_TEST_SOURCE/bin/omarchy-setup-direct-boot" ||
  fail "the upstream user-selected Direct Boot command is unavailable"
pass "Limine is the default path and direct UKI boot remains user-selected"

grep -Eq '^\^linux-firmware\(\$\|-\)$' "$ROOT/profiles/aarch64-virt/remove-package-patterns" ||
  fail "aarch64-virt does not exclude linux-firmware and its split packages"
grep -Fq 'resolve_profile_removed_packages' "$ROOT/bin/build-image" ||
  fail "image validation does not enforce profile package removals"
grep -Fq 'share            /mnt/hostshare     9p     trans=virtio,version=9p2000.L,rw,_netdev,nofail,auto 0 0' \
  "$ROOT/bin/build-image" ||
  fail "the image does not preconfigure QEMU host directory sharing"
bash -n "$ROOT/profiles/aarch64-virt/overlay/usr/lib/omarchy-aarch64/setup-hostshare" ||
  fail "the hostshare UID/GID mapping helper has invalid shell syntax"
bash -c '
  source "$1"
  [[ $(build_mapping 501 20 1000 1000) == "501/1000:@20/@1000" ]]
  [[ -z $(build_mapping 1000 1000 1000 1000) ]]
' _ "$ROOT/profiles/aarch64-virt/overlay/usr/lib/omarchy-aarch64/setup-hostshare" ||
  fail "the hostshare helper does not derive UID/GID mappings dynamically"
grep -Fq 'target="$home/Hostshare"' \
  "$ROOT/profiles/aarch64-virt/overlay/usr/lib/omarchy-aarch64/setup-hostshare" ||
  fail "the mapped host share does not use the generic Hostshare name"
grep -Fq 'After=omarchy-provision-owner.service mnt-hostshare.mount' \
  "$ROOT/profiles/aarch64-virt/overlay/etc/systemd/system/omarchy-aarch64-hostshare.service" ||
  fail "the hostshare mapper does not wait for owner provisioning and the raw mount"
grep -Fq 'Wants=mnt-hostshare.mount' \
  "$ROOT/profiles/aarch64-virt/overlay/etc/systemd/system/omarchy-aarch64-hostshare.service" ||
  fail "the hostshare mapper does not pull the raw 9p mount into its transaction"
grep -Fq 'Before=display-manager.service' \
  "$ROOT/profiles/aarch64-virt/overlay/etc/systemd/system/omarchy-aarch64-hostshare.service" ||
  fail "the hostshare mapper does not finish before desktop login"
grep -Fq 'kernel/fs/9p/9p.ko' "$ROOT/bin/build-image" ||
  fail "image validation does not require 9p filesystem support"
grep -Fq 'kernel/net/9p/9pnet_virtio.ko' "$ROOT/bin/build-image" ||
  fail "image validation does not require the VirtIO 9p transport"
grep -Fq -- '--continue-at -' "$ROOT/bin/build-image" ||
  fail "rolling image downloads cannot resume after interruption"
grep -Fq 'partial="$2.part"' "$ROOT/bin/build-image" ||
  fail "rolling image downloads are not staged atomically"
grep -Fq 'PACMAN_CACHE_DIR="$CACHE_DIR/pacman-aarch64"' "$ROOT/bin/build-image" ||
  fail "target package downloads are not retained across image build retries"
grep -Fq 'reclaim_conversion_space' "$ROOT/bin/build-image" &&
  grep -Fq 'OMARCHY_IMAGE_LOW_DISK=${OMARCHY_IMAGE_LOW_DISK:-0}' \
    "$ROOT/bin/build-image-container" ||
  fail "CI cannot reclaim transient package caches before QCOW2 conversion"
grep -Fq 'runs-on: ubuntu-24.04-arm' "$ROOT/.github/workflows/release-image.yml" ||
  fail "image Releases are not built on the native Ubuntu 24.04 ARM runner"
grep -Fq "OMARCHY_UTM_CONSUME_IMAGE: '1'" "$ROOT/.github/workflows/release-image.yml" ||
  fail "the release workflow retains the source QCOW2 while creating split assets"
grep -Fq 'qemu-img check build/omarchy-aarch64-virt.qcow2' \
  "$ROOT/.github/workflows/release-image.yml" ||
  fail "the release workflow does not validate the finished QCOW2"
if grep -Fq 'actions/upload-artifact' "$ROOT/.github/workflows/release-image.yml"; then
  fail "the multi-gigabyte image is copied through Actions artifact storage"
fi
grep -Fq 'uses: actions/cache/save@v6' "$ROOT/.github/workflows/release-image.yml" ||
  fail "verified rolling inputs are only cached after the entire Release succeeds"
grep -Fq -- '--notes-file RELEASE_NOTES.md' "$ROOT/.github/workflows/release-image.yml" &&
  grep -Fq 'releases/latest/download/install-Omarchy-virt.command' \
    "$ROOT/RELEASE_NOTES.md" &&
  grep -Fq 'releases/latest/download/install-Omarchy-virt.command' "$ROOT/README.md" ||
  fail "GitHub Releases do not expose the one-command latest installer"
grep -Fq 'efi_variable_storage: "omitted-and-created-by-utm"' \
  "$ROOT/bin/package-utm-release" ||
  fail "UTM release metadata does not promise clean firmware state"
pass "native GitHub image publishing avoids duplicate artifacts and EFI state"
grep -Fq 'pacman failed after 3 attempts' "$ROOT/bin/build-image" ||
  fail "target package installation does not tolerate transient mirror failures"
grep -Fq -- '--dearmor --output "$partial" "$ROOTFS_KEYRING"' "$ROOT/bin/build-image" ||
  fail "ASCII-armored Arch Linux ARM keys are not normalized for gpgv"
grep -Fq -- '--keyring "$ROOTFS_VERIFY_KEYRING"' "$ROOT/bin/build-image" ||
  fail "rootfs verification does not use the normalized keyring"
if grep -Fq 'linux-firmware' "$ROOT/bin/build-image"; then
  fail "generic image builder contains a profile-specific firmware exception"
fi
pass "profile package rules remove firmware without generic-builder exceptions"

if grep -Fq 'source=/dev,target=/dev' "$ROOT/bin/build-image-container"; then
  fail "the privileged image container exposes the host /dev tree as a writable bind mount"
fi
grep -Fq 'ensure_loop_device_nodes' "$ROOT/bin/build-image" ||
  fail "the isolated image container cannot restore missing base loop nodes"
if sed -n '/^cleanup()/,/^}/p' "$ROOT/bin/build-image" | grep -Fq 'rm -rf'; then
  fail "failed image cleanup recursively deletes mount-tree paths"
fi
grep -Fq 'path_has_mounts "$side"' "$ROOT/bin/build-image" ||
  fail "failed image cleanup does not guard retained mount trees"
grep -Fq 'gpgconf --homedir /etc/pacman.d/gnupg --kill all' "$ROOT/bin/build-image" ||
  fail "image assembly does not stop the pacman keyring agent before unmounting"
grep -Fq 'process_root == "$MOUNT_DIR"' "$ROOT/bin/build-image" ||
  fail "target helper cleanup is not scoped to the disposable image root"
grep -Fq 'package-replacements' "$ROOT/bin/build-image" ||
  fail "the image does not preserve package replacements for reinstall workflows"
grep -Fq 'validate_omarchy_repository_manifest' "$ROOT/bin/build-image" ||
  fail "the image can combine a repository snapshot with a different Omarchy source commit"
grep -Fq 'etc/omarchy-aarch64/excluded-packages' "$ROOT/bin/build-image" ||
  fail "the image does not preserve profile exclusions for reinstall workflows"
grep -Fq 'cp -a --no-preserve=ownership "$OVERLAY_DIR/." "$MOUNT_DIR/"' \
  "$ROOT/bin/build-image" ||
  fail "the profile overlay can leak the builder UID/GID into the target rootfs"
grep -Fq -- '--omarchy-repository /omarchy-repository' "$ROOT/bin/build-image-container" ||
  fail "the container wrapper cannot expose a local signed repository to the builder"
grep -Fq 'mount -o remount,bind,ro "$MOUNT_DIR/run/omarchy-aarch64-repository"' \
  "$ROOT/bin/build-image" ||
  fail "the local development repository is writable inside the image chroot"
grep -Fq 'root_owned_paths=(' "$ROOT/bin/build-image" ||
  fail "image validation does not enforce trusted rootfs directory ownership"
pass "container isolation, mount cleanup, ownership, and repository update boundaries are guarded"

grep -q '^ConditionPathExists=/var/lib/omarchy/provisioning/pending$' \
  "$OMARCHY_TEST_SOURCE/install/provisioning/omarchy-provision-owner.service" ||
  fail "first-boot provisioning is not gated by its pending marker"
bash "$OMARCHY_TEST_SOURCE/test/shell.d/aarch64-runtime-test.sh"
pass "fork exposes the deferred AArch64 VM runtime contract"

if rg -n 'asahi-alarm|grub-install' "$ROOT/bin" "$ROOT/config" "$ROOT/profiles" >/dev/null; then
  fail "retired Apple/Asahi/GRUB installation logic remains active"
fi
pass "active image orchestration is independent of Apple, Asahi, and GRUB"

grep -q '^OMARCHY_AARCH64_REPOSITORY_URL=https://github.com/riverscn/omarchy-pkgs-aarch64/releases/download/aarch64-stable$' \
  "$ROOT/sources.env" || fail "image source does not use the explicit stable AArch64 repository release"
for channel in stable rc edge; do
  grep -q "^$channel=https://github.com/riverscn/omarchy-pkgs-aarch64/releases/download/aarch64-$channel$" \
    "$OMARCHY_TEST_SOURCE/default/pacman/omarchy-aarch64-repositories.conf" ||
    fail "runtime source does not map the $channel AArch64 package channel"
done
grep -Fq 'target_chroot pacman-key --lsign-key "$OMARCHY_AARCH64_SIGNING_FINGERPRINT"' \
  "$ROOT/bin/build-image" || fail "repository bootstrap key is not locally trusted"
grep -Fq 'pre-refresh-pacman.d/omarchy-aarch64-repository' "$ROOT/bin/build-image" ||
  fail "Omarchy pacman refreshes can discard the AArch64 repository"
if rg -n 'omarchy-mac/omarchy-pkgs-aarch64|OMARCHY_AARCH64_RELEASE_URL|pacman -U' \
  "$ROOT/bin" "$ROOT/config" "$ROOT/sources.env" >/dev/null; then
  fail "retired unsigned/local package installation remains active"
fi
pass "the signed AArch64 repository remains enabled across system and Omarchy updates"

nested_source_pattern='[$]PROJECT_ROOT/omarchy-aarch64|[$]ROOT/omarchy-aarch64'
if rg -n "$nested_source_pattern" \
  "$ROOT/bin" "$ROOT/lib" "$ROOT/tests" >/dev/null; then
  fail "the image project still assumes a nested Omarchy source checkout"
fi
pass "image orchestration does not depend on a nested source repository"

echo "VERDICT: PASS"
